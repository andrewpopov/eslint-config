{
  "name": "@andrewpopov/eslint-config",
  "version": "0.2.0",
  "description": "Composable ESLint flat-config presets shared across andrewpopov personal projects.",
  "type": "commonjs",
  "main": "index.cjs",
  "exports": {
    ".": {
      "require": "./index.cjs",
      "import": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "presets",
    "factories",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint ."
  },
  "dependencies": {
    "typescript-eslint": "8.64.0",
    "globals": "15.15.0",
    "@eslint/eslintrc": "3.3.6"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10",
    "eslint-plugin-react-hooks": "^5 || ^6 || ^7",
    "eslint-plugin-react-refresh": "^0.4",
    "eslint-plugin-astro": "^1"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    }
  },
  "license": "MIT"
}
